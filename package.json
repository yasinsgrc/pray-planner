{
  "name": "vakit",
  "description": "VAKİT — Türkçe, sakin ve manevi bir namaz vakti sayaç uygulaması.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n vite,server -c blue,green \"npm:dev\" \"npm:dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:server": "node --import tsx --test \"server/**/*.test.ts\"",
    "test:frontend": "node --import tsx --test \"src/**/*.test.ts\"",
    "test": "npm run test:server && npm run test:frontend",
    "test:push": "tsx server/send-test-push.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "visual": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "adhan": "^4.4.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hijri-converter": "^1.1.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
