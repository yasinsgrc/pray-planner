# --- Web Push bildirim sunucusu (server/) ---
# `npx web-push generate-vapid-keys` ile bir kereye mahsus üretilir. Özel
# anahtar yalnızca sunucu ortamında (Railway) kalır, hiçbir dosyaya veya
# commit'e yazılmaz.
VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="MY_VAPID_PRIVATE_KEY"
# Push servislerinin sorun durumunda ulaşabileceği iletişim adresi.
VAPID_SUBJECT="mailto:you@example.com"
# Express sunucusunun dinleyeceği port. Çoğu PaaS bunun yerine PORT'u
# enjekte eder (server/index.ts önce PORT'a bakar) — bu yalnızca yerel
# geliştirme ve PORT tanımlı olmayan ortamlar için bir yedek.
SERVER_PORT="8787"

# Frontend (Netlify) ve API (Railway) artık farklı origin'lerde
# yaşayabiliyor (design-refresh-v3 Faz 15) — CORS yalnızca bu adrese açılır,
# başka hiçbir köken kabul edilmez.
CORS_ALLOWED_ORIGIN="https://vakit.yasinsigirci.com.tr"

# Tanımlıysa push abonelikleri ve zamanlamaları Postgres'te (kalıcı diskte)
# saklanır; tanımlı değilse bellek içi bir depo kullanılır (yalnızca
# geliştirme için uygundur — her yeniden başlatmada sıfırlanır, çoğu
# PaaS'ın dosya sistemi zaten geçicidir). Sunucu yalnızca endpoint, push
# anahtarları (p256dh/auth) ve gelecekteki UTC zaman damgalarını saklar —
# konum, şehir, hesaplama yöntemi asla saklanmaz (bkz. server/pushStore.ts).
DATABASE_URL=""

# --- API adresi (istemci, src/) ---
# Frontend ve API farklı origin'lerdeyse (Netlify + Railway) zorunlu —
# tanımsızsa istemci göreli /api/* yollarını kullanır (tek-origin Node host
# dağıtımı için doğru davranış). VITE_ önekli olduğu için build'e gömülür,
# gizli bir değer değildir.
VITE_API_BASE_URL="https://api.vakit.yasinsigirci.com.tr"

# --- "Destek Ol" (Ayarlar > Hakkında) ---
# Hepsi isteğe bağlı: tanımlanmayan değişkenin karşılık geldiği seçenek
# Destek Ol sayfasında hiç render edilmez. VITE_ önekli olduğu için
# tarayıcıya gönderilen build'e gömülürler — burada gizli/hassas bir
# değer değil, yalnızca herkese açık IBAN/bağlantı bilgisi olmalı.
VITE_SUPPORT_IBAN="TR00 0000 0000 0000 0000 0000 00"
VITE_SUPPORT_NAME="Ad Soyad"
VITE_SUPPORT_PAYMENT_URL="https://example.com/destek-ol"
VITE_SUPPORT_STORE_URL="https://play.google.com/store/apps/details?id=..."

# --- Gizlilik Politikası (Ayarlar > Hakkında > Gizlilik) ---
# KVKK m.5/2-c uyarınca veri sorumlusunun kimliği — taslak metin
# (docs/ altında) bu doldurulmadan yayına çıkmamalı. VITE_ önekli
# olduğu için build'e gömülürler; hiçbiri gizli bir değer değildir,
# ama hiçbiri de güvenli bir varsayılana sahip değildir — tanımsız
# bırakılırsa politika ekranında gözle görülür bir "[TANIMLANMADI]"
# uyarısı olarak kalır.
VITE_PRIVACY_ENTITY_NAME="Ad Soyad veya Şirket Unvanı"
VITE_PRIVACY_ADDRESS="Açık adres"
VITE_PRIVACY_CONTACT_EMAIL="kvkk@example.com"
VITE_PRIVACY_HOSTING_PROVIDER="ör. Render, Railway, Fly.io"
VITE_PRIVACY_LOG_RETENTION_DAYS="30"
