# Bu dosyayı `keystore.properties` olarak kopyala ve gerçek değerlerle
# doldur. `keystore.properties` (bu şablon değil) .gitignore'da — depoya
# asla girmez. İmzalama parolası ve keystore dosyası tamamen geliştiricinin
# elinde tutulmalı; bu ajan hiçbirini üretmez veya saklamaz.
storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
