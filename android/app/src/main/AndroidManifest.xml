<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Kilit ekranı widget desteği mevcut AppWidget API'sini kullanır
             (design-refresh-v3 Faz 23 Commit 4) — ayrı bir bildirim/servis
             tabanlı kilit ekranı implementasyonu yok. -->
        <receiver
            android:name=".widget.VakitWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.vakit.widget.ACTION_REFRESH_BOUNDARY" />
                <action android:name="com.vakit.widget.ACTION_MINUTE_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vakit_widget_info" />
        </receiver>

        <!-- Varyant C: yalnızca çember + saniyeli sayaç (günlük vakit satırı
             yok). Alarm sahipliği hâlâ VakitWidgetProvider'da (bkz.
             BaseVakitWidgetProvider.boundaryAlarmPendingIntent) — bu receiver
             yalnızca APPWIDGET_UPDATE'i almak için var. -->
        <receiver
            android:name=".widget.VakitRingWidgetProvider"
            android:label="@string/widget_name_ring_seconds"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vakit_ring_widget_info" />
        </receiver>

        <!-- Varyant B: çember + günlük vakit satırı + dakika hassasiyetli sayaç.
             Alarm sahipliği hâlâ VakitWidgetProvider'da (bkz.
             BaseVakitWidgetProvider.boundaryAlarmPendingIntent/minuteAlarmPendingIntent)
             — bu receiver yalnızca APPWIDGET_UPDATE'i almak için var. -->
        <receiver
            android:name=".widget.VakitWidgetMinuteProvider"
            android:label="@string/widget_name_full_minute"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vakit_widget_minute_info" />
        </receiver>

        <!-- Varyant D: yalnızca çember + dakika hassasiyetli sayaç (günlük
             vakit satırı yok). Alarm sahipliği hâlâ VakitWidgetProvider'da
             (bkz. BaseVakitWidgetProvider.boundaryAlarmPendingIntent/
             minuteAlarmPendingIntent) — bu receiver yalnızca
             APPWIDGET_UPDATE'i almak için var. -->
        <receiver
            android:name=".widget.VakitRingMinuteWidgetProvider"
            android:label="@string/widget_name_ring_minute"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vakit_ring_widget_minute_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Faz 26 Commit 1 — Capacitor 8'in BridgeWebChromeClient WebView
         geolocation isteği için bu iki izni istiyor; burada tanımsız
         kalırsa Android izni anında reddediyor ve navigator.geolocation
         her zaman PERMISSION_DENIED veriyor (APK'da GPS butonu asla
         çalışmıyordu). ACCESS_BACKGROUND_LOCATION bilerek eklenmiyor. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Vakit bildirimlerinin dakikasında düşmesi için (design-refresh-v3
         Faz 23 Commit 2). USE_EXACT_ALARM DEĞİL — Google bu izni yalnızca
         çalar saat/takvim uygulamalarıyla sınırlıyor. SCHEDULE_EXACT_ALARM
         izni yoksa veya kullanıcı sistem ayarlarından kapatırsa,
         @capacitor/local-notifications ve Android otomatik olarak yaklaşık
         teslimat moduna düşer — kod tarafında özel bir geri düşüş
         gerekmez. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
