<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnızca widget seçicide (previewLayout) gösterilir; esma_widget.xml'in
     statik bir kopyasıdır. Gerçek veri burada YOKTUR, Kotlin tarafından
     doldurulmaz. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_preview_esma_arabic"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:textSize="26sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/widget_preview_esma_transliteration"
        android:textColor="@color/widget_accent"
        android:textStyle="bold"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/widget_preview_esma_meaning"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4" />
</LinearLayout>
