<?xml version="1.0" encoding="utf-8"?>
<!-- vakit_widget_info.xml'in çember-yalnız varyantı. updatePeriodMillis=0
     ve tetikleyiciler A ile aynı mantığı paylaşır (bkz. BaseVakitWidgetProvider);
     minWidth/minHeight/targetCell burada küçük bir kare hücreye (2x2) göre
     ayarlı, A'nın 4x2 dikdörtgenine göre değil. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/vakit_ring_widget"
    android:previewLayout="@layout/vakit_ring_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_description_ring_seconds" />
