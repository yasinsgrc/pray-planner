<?xml version="1.0" encoding="utf-8"?>
<!-- vakit_widget_info.xml'in dakika hassasiyetli varyantı — minWidth/minHeight/
     targetCell A ile aynı (4x2), çünkü aynı günlük vakit satırlı düzeni
     kullanır (bkz. vakit_widget_minute.xml). updatePeriodMillis=0 ve
     tetikleyiciler A ile aynı mantığı paylaşır (bkz. BaseVakitWidgetProvider). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/vakit_widget_minute"
    android:previewLayout="@layout/vakit_widget_minute_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_description_full_minute" />
